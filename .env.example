# Copia este archivo a .env y ajusta los valores.

# Base de datos
POSTGRES_DB=baches
POSTGRES_USER=baches
POSTGRES_PASSWORD=replace-with-a-strong-db-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Docker Compose
APP_PORT=8080

# Django
# Usa un valor aleatorio de al menos 32 caracteres en producción.
DJANGO_SECRET_KEY=replace-with-at-least-64-random-characters
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Cliente web (Astro) permitido para llamar a la API
CORS_ALLOWED_ORIGINS=http://localhost:4321
CSRF_TRUSTED_ORIGINS=http://localhost:4321
WEB_URL=http://localhost:4321

# URL pública del frontend compilado y del backend que ve el navegador.
# En producción, por ejemplo: https://tizibaches.example
PUBLIC_API_URL=http://localhost:8080
PUBLIC_APP_URL=/app
PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Google OAuth.
# GOOGLE_WEB_CLIENT_ID es el cliente Web (serverClientId y audiencia del backend).
# GOOGLE_ANDROID_CLIENT_ID es el cliente Android (package + SHA-1).
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
# Audiencias extra opcionales, separadas por coma.
GOOGLE_CLIENT_IDS=
# Si en el futuro el backend intercambia authorization codes, el secreto va
# solo acá. El flujo actual de ID token no lo usa.
# GOOGLE_SECRET=

# Producción detrás de un proxy HTTPS.
# DJANGO_TRUST_PROXY=1
# DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_SESSION_COOKIE_SECURE=1
# DJANGO_CSRF_COOKIE_SECURE=1
# DJANGO_SECURE_HSTS_SECONDS=31536000

# Moderación de fotos con Gemini + LangChain (opcional).
# Usa el nivel pago en producción: el nivel gratuito puede usar las fotos
# para mejorar productos de Google. El worker se levanta con:
# docker compose --profile ai up -d ai-worker
# La key también se acepta como GEMINIS_KEY por compatibilidad.
AI_VERIFICATION_ENABLED=0
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.1-flash-lite
AI_CONFIRM_THRESHOLD=0.85
AI_REJECT_THRESHOLD=0.90
AI_TIMEOUT_SECONDS=25
AI_MAX_OUTPUT_TOKENS=200
AI_THINKING_LEVEL=minimal

# Área de la ciudad para validar reportes y centrar el mapa.
# CITY_BBOX es min_lon,min_lat,max_lon,max_lat.
CITY_NAME=Tizimín
CITY_CENTER_LAT=21.1430
CITY_CENTER_LON=-88.1519
CITY_ZOOM=14
CITY_BBOX=-88.19,21.11,-88.11,21.18

# Los reportes dentro de esta distancia (metros) se unen al mismo bache.
DEDUPE_RADIUS_M=15

# Caché del GeoJSON. El cliente refresca cada 60–90 segundos y usa ETag.
GEOJSON_CACHE_SECONDS=30

# Geocodificación inversa opcional para completar la dirección de un reporte.
# Si se desactiva, se usa el fallback "Tizimín, Yucatán".
GEOCODING_ENABLED=0
GEOCODING_URL=https://nominatim.openstreetmap.org/reverse
GEOCODING_USER_AGENT=Tizibaches/1.0
GEOCODING_TIMEOUT_SECONDS=6

# Opcional: solo si GDAL/GEOS no están en la ruta del sistema.
# GDAL_LIBRARY_PATH=/ruta/a/libgdal.so
# GEOS_LIBRARY_PATH=/ruta/a/libgeos_c.so
