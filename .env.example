# Plantilla de producción. Copia este archivo a .env y completa los valores.
# Nunca subas .env al repositorio.

# ---------------------------------------------------------------------------
# Dominio y puerto público
# ---------------------------------------------------------------------------
# El dominio se usa en Django, las URLs públicas y la app.
DOMAIN=tizibaches.example
# Puerto local que expone nginx. Con cloudflared en el host:
# HOST_PORT=8080 -> 127.0.0.1:8080:80
HOST_PORT=8080

# URL pública completa, incluyendo esquema y, si aplica, puerto.
# Ejemplos: https://tizibaches.example  http://localhost:8080
PUBLIC_API_URL=https://tizibaches.example
PUBLIC_APP_URL=https://tizibaches.example/app
PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
WEB_URL=https://tizibaches.example

# Valores que consume el generador de configuración de Flutter.
API_BASE_URL=https://tizibaches.example
PUBLIC_WEB_URL=https://tizibaches.example/mapa

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
POSTGRES_DB=baches
POSTGRES_USER=baches
POSTGRES_PASSWORD=replace-with-a-strong-db-password
# En Docker Compose el backend usa el host interno "db"; para desarrollo local
# usa localhost.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
# Genera un valor aleatorio de al menos 32 caracteres para producción.
DJANGO_SECRET_KEY=replace-with-at-least-64-random-characters
DJANGO_DEBUG=0
# Sin esquema ni puerto: solo hostnames separados por coma.
DJANGO_ALLOWED_HOSTS=tizibaches.example
CSRF_TRUSTED_ORIGINS=https://tizibaches.example
CORS_ALLOWED_ORIGINS=https://tizibaches.example

# Producción detrás de HTTPS. Si todavía pruebas en HTTP local, cambia estos
# valores a 0 y DJANGO_DEBUG=1.
DJANGO_TRUST_PROXY=1
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SESSION_COOKIE_SECURE=1
DJANGO_CSRF_COOKIE_SECURE=1
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=1
DJANGO_SECURE_HSTS_PRELOAD=1

# Ajusta los workers según CPU/RAM del servidor.
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

# ---------------------------------------------------------------------------
# Google OAuth
# ---------------------------------------------------------------------------
# El cliente Web es la audiencia del backend y el serverClientId de Flutter.
# El cliente Android se registra con el package y el SHA-1 de la firma.
GOOGLE_WEB_CLIENT_ID=<web-application-client-id>.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=<android-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_IDS=<web-application-client-id>.apps.googleusercontent.com

# El flujo actual usa ID tokens y no necesita el secreto del cliente.
# Si en el futuro se intercambian authorization codes, va solo en el backend.
# GOOGLE_SECRET=

# ---------------------------------------------------------------------------
# IA de moderación
# ---------------------------------------------------------------------------
# En producción usa el nivel pagado de Gemini. El nivel gratuito puede usar
# las fotos para mejorar productos de Google.
AI_VERIFICATION_ENABLED=1
GEMINI_API_KEY=
# También se acepta GEMINIS_KEY por compatibilidad con el entorno local.
GEMINI_VISION_MODEL=gemini-3.1-flash-lite
AI_CONFIRM_THRESHOLD=0.85
AI_REJECT_THRESHOLD=0.90
AI_TIMEOUT_SECONDS=25
AI_MAX_OUTPUT_TOKENS=200
AI_THINKING_LEVEL=minimal

# ---------------------------------------------------------------------------
# Geocodificación y mapa
# ---------------------------------------------------------------------------
# Caché del GeoJSON; el cliente refresca cada 60–90 segundos y usa ETag.
GEOJSON_CACHE_SECONDS=30

# Geocodificación inversa con Nominatim para completar direcciones.
# Usa un User-Agent identificable y respeta el límite de una petición/segundo.
GEOCODING_ENABLED=1
GEOCODING_URL=https://nominatim.openstreetmap.org/reverse
GEOCODING_USER_AGENT=Tizibaches/1.0 (contact: replace-with-contact-email)
GEOCODING_TIMEOUT_SECONDS=6

CITY_NAME=Tizimín
CITY_CENTER_LAT=21.1430
CITY_CENTER_LON=-88.1519
CITY_ZOOM=14
CITY_BBOX=-88.19,21.11,-88.11,21.18

# Los reportes dentro de esta distancia se agrupan en el mismo bache.
DEDUPE_RADIUS_M=15

# ---------------------------------------------------------------------------
# Opcional: rutas no estándar de GDAL/GEOS
# ---------------------------------------------------------------------------
# GDAL_LIBRARY_PATH=/ruta/a/libgdal.so
# GEOS_LIBRARY_PATH=/ruta/a/libgeos_c.so
