---
import { formatDate, formatNumber } from "@/lib/format";
import type { Stats } from "@/lib/stats";

interface Props {
  stats: Stats;
}

const { stats } = Astro.props;

const items = [
  { value: stats.reports, label: "reportes ciudadanos" },
  { value: stats.open, label: "expedientes abiertos" },
  { value: stats.fixed, label: "marcados como reparados" },
  { value: stats.total, label: "expedientes en el mapa" },
];
---

<section class="bg-paper-deep text-ink" aria-label="Resumen del registro">
  <div class="mx-auto grid max-w-[1440px] gap-10 px-4 py-14 sm:px-6 lg:grid-cols-[1.05fr_1.95fr] lg:items-end lg:px-8 lg:py-16">
    <div>
      <h2 class="max-w-[16ch] font-heading text-[clamp(2rem,3.4vw,3.4rem)] font-semibold leading-[0.95] tracking-[-0.045em]">
        Así va el registro.
      </h2>
      <p class="mt-4 max-w-[38ch] text-[15px] leading-6 text-ink/70">
        Cada cifra sale de los reportes de vecinos. Puedes abrir cualquiera en el mapa y ver la
        foto, la calle y el estado.
      </p>
      <p class="mt-6 text-[13px] text-ink/55">Actualizado el {formatDate(stats.lastReport)}</p>
    </div>

    <div class="grid grid-cols-2 gap-x-6 gap-y-8 sm:grid-cols-4">
      {
        items.map((item) => (
          <div>
            <p class="font-heading text-[clamp(2.6rem,4.4vw,4.2rem)] font-semibold leading-none tracking-[-0.06em]">
              {formatNumber(item.value)}
            </p>
            <p class="mt-2 max-w-[13ch] text-[14px] leading-5 text-ink/65">{item.label}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
