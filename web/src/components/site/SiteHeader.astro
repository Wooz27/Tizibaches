---
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
import LogoMark from "./LogoMark.astro";

const appUrl = import.meta.env.PUBLIC_APP_URL || "/app";
const links = [
  { href: "/#que-es", label: "Qué es" },
  { href: "/#como-funciona", label: "Cómo funciona" },
  { href: "/mapa", label: "Mapa abierto" },
];
---

<header class="fixed inset-x-0 top-4 z-50 mx-auto w-[calc(100%-2rem)] max-w-[1400px]">
  <div class="flex h-16 items-center justify-between gap-4 rounded-full border border-label/15 bg-ink px-4 text-label sm:px-6">
    <a href="/" class="flex min-w-0 items-center gap-3" aria-label="Tízibaches, inicio">
      <LogoMark class="size-9 shrink-0 text-maize" />
      <span class="flex min-w-0 flex-col leading-none">
        <span class="font-heading text-[1.45rem] font-semibold leading-none tracking-[-0.04em]">Tízibaches</span>
        <span class="mt-1 font-mono text-label/55">
          Tizimín, Yucatán
        </span>
      </span>
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="Navegación principal">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="text-[13px] font-medium text-label/65 underline decoration-transparent decoration-1 underline-offset-4 transition-colors hover:text-label hover:decoration-maize"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href="/mapa"
        class={cn(
          buttonVariants({ size: "sm" }),
          "hidden h-9 bg-maize px-3.5 text-ink hover:bg-label hover:text-ink sm:inline-flex",
        )}
      >
        Abrir mapa
        <span aria-hidden="true" class="ml-1 text-sm leading-none">↗</span>
      </a>
      <a
        href={appUrl}
        class={cn(
          buttonVariants({ variant: "outline", size: "sm" }),
          "h-9 border-label/30 bg-transparent px-3.5 text-label hover:bg-label/10 hover:text-label",
        )}
      >
        App
      </a>

      <details class="relative md:hidden">
        <summary
          class="flex size-9 cursor-pointer list-none items-center justify-center border border-label/30 text-label transition-colors hover:bg-label/10 [&::-webkit-details-marker]:hidden"
          aria-label="Abrir menú de navegación"
        >
          <svg viewBox="0 0 20 20" class="size-4" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M3 6h14M3 10h14M3 14h14" />
          </svg>
        </summary>
        <nav
          class="absolute right-0 top-[calc(100%+0.5rem)] z-50 w-56 border border-label/20 bg-ink p-2"
          aria-label="Navegación móvil"
        >
          {
            links.map((link) => (
              <a
                href={link.href}
                class="block px-3 py-2.5 text-sm text-label/70 transition-colors hover:bg-label/10 hover:text-label"
              >
                {link.label}
              </a>
            ))
          }
          <a
            href={appUrl}
            class="mt-1 block border-t border-label/20 px-3 py-2.5 text-maize"
          >
            Abrir la app ↗
          </a>
        </nav>
      </details>
    </div>
  </div>
</header>
