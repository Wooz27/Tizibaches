---
import SiteFooter from "@/components/site/SiteFooter.astro";
import SiteHeader from "@/components/site/SiteHeader.astro";
import { buttonVariants } from "@/components/ui/button";
import BaseLayout from "@/layouts/main.astro";
import { cn } from "@/lib/utils";

const apkUrl = import.meta.env.PUBLIC_APK_URL || "";
const apkVersion = import.meta.env.PUBLIC_APK_VERSION || "";
const apkDate = import.meta.env.PUBLIC_APK_DATE || "";
const apkSize = import.meta.env.PUBLIC_APK_SIZE || "";
const apkSha256 = import.meta.env.PUBLIC_APK_SHA256 || "";
const hasApk = apkUrl.trim().length > 0;

const steps = [
  {
    title: "Abre el enlace desde el teléfono",
    body: "Hazlo desde el Android. Si lo abres en la computadora, pásate el enlace al teléfono.",
  },
  {
    title: "Deja instalar",
    body: "Android te va a pedir permiso para instalar desde el navegador. Búscalo en Ajustes como «Instalar apps desconocidas» y actívalo solo para el navegador que uses.",
  },
  {
    title: "Acepta el aviso de Play Protect",
    body: "Como no viene de Google Play, Android muestra una advertencia. Elige «Instalar de todos modos».",
  },
  {
    title: "Entra con Google",
    body: "Para que el botón de Google funcione, tu correo tiene que estar en la lista de prueba del proyecto. Si no aparece o falla, escríbenos y lo agregamos.",
  },
];
---

<BaseLayout
  title="Versión de prueba para Android · Tízibaches"
  description="Descarga la versión de prueba de Tízibaches para Android. Es una build alfa, fuera de Google Play."
  noindex={true}
>
  <SiteHeader />
  <main id="contenido" class="pt-24">
    <section class="bg-label text-ink">
      <div
        class="mx-auto grid max-w-[1440px] gap-12 px-4 py-16 sm:px-6 lg:grid-cols-[1.1fr_0.9fr] lg:items-start lg:gap-20 lg:px-8 lg:py-24"
      >
        <div>
          <p
            class="inline-flex items-center gap-2 bg-maize px-3 py-1.5 font-mono text-[10px] uppercase tracking-[0.12em] text-ink"
          >
            <span class="size-1.5 rounded-full bg-ink" aria-hidden="true"></span>
            Versión de prueba
          </p>

          <h1
            class="mt-6 max-w-[14ch] font-heading text-[clamp(2.6rem,6vw,5.6rem)] font-semibold leading-[0.92] tracking-[-0.055em]"
          >
            La app, antes de salir.
          </h1>

          <p class="mt-6 max-w-[52ch] text-[16px] leading-7 text-ink-soft">
            Esta build todavía no pasa por Google Play, así que se instala a mano. Es una alfa:
            puede tener fallos y cambiar de una semana a otra. Si algo se rompe, avísanos y lo
            arreglamos.
          </p>

          <div
            class="mt-8 border border-ink/15 bg-paper-deep p-5"
            aria-label="Aviso sobre la versión de prueba"
          >
            <p class="text-[14px] leading-6 text-ink">
              <strong class="font-semibold">Instálala solo si te la pasamos nosotros.</strong>
              Es una versión de prueba para el grupo que está ayudando con las primeras pruebas.
              En cuanto la app esté en Google Play, conviene cambiar a esa versión.
            </p>
          </div>

          <div class="mt-8 flex flex-wrap items-center gap-3">
            {
              hasApk ? (
                <a
                  href={apkUrl}
                  class={cn(
                    buttonVariants({ size: "lg" }),
                    "h-12 rounded-none bg-maize px-5 text-ink hover:bg-ink hover:text-label",
                  )}
                >
                  Descargar APK
                  <span aria-hidden="true" class="ml-1">
                    ↓
                  </span>
                </a>
              ) : (
                <span class="bg-paper-deep px-4 py-3 text-[14px] text-ink-soft">
                  La descarga no está disponible en este momento.
                </span>
              )
            }
            <a
              href="/mapa"
              class="text-[14px] font-medium text-ink underline decoration-ink/30 underline-offset-4 transition-colors hover:decoration-ink"
            >
              Ver el mapa abierto
            </a>
          </div>

          {
            hasApk && (
              <dl class="mt-8 grid gap-x-8 gap-y-4 border-t border-ink/15 pt-6 text-[13px] sm:grid-cols-2">
                {apkVersion && (
                  <div>
                    <dt class="font-mono text-[9px] uppercase tracking-[0.12em] text-ink/45">
                      Versión
                    </dt>
                    <dd class="mt-1 text-ink">{apkVersion}</dd>
                  </div>
                )}
                {apkDate && (
                  <div>
                    <dt class="font-mono text-[9px] uppercase tracking-[0.12em] text-ink/45">
                      Publicada
                    </dt>
                    <dd class="mt-1 text-ink">{apkDate}</dd>
                  </div>
                )}
                {apkSize && (
                  <div>
                    <dt class="font-mono text-[9px] uppercase tracking-[0.12em] text-ink/45">
                      Tamaño
                    </dt>
                    <dd class="mt-1 text-ink">{apkSize}</dd>
                  </div>
                )}
                {apkSha256 && (
                  <div class="sm:col-span-2">
                    <dt class="font-mono text-[9px] uppercase tracking-[0.12em] text-ink/45">
                      SHA-256
                    </dt>
                    <dd class="mt-1 break-all font-mono text-[11px] leading-5 text-ink-soft">
                      {apkSha256}
                    </dd>
                  </div>
                )}
              </dl>
            )
          }
        </div>

        <div>
          <h2 class="font-heading text-2xl font-semibold tracking-[-0.035em]">
            Cómo instalarla
          </h2>
          <ol class="mt-5 divide-y divide-ink/10 border-y border-ink/10">
            {
              steps.map((step, index) => (
                <li class="flex gap-4 py-5">
                  <span
                    class="mt-0.5 flex size-6 shrink-0 items-center justify-center bg-ink font-mono text-[11px] text-label"
                    aria-hidden="true"
                  >
                    {index + 1}
                  </span>
                  <div>
                    <h3 class="text-[14px] font-semibold leading-5 text-ink">{step.title}</h3>
                    <p class="mt-1.5 text-[13px] leading-6 text-ink-soft">{step.body}</p>
                  </div>
                </li>
              ))
            }
          </ol>

          {
            apkSha256 && (
              <div class="mt-6 border border-ink/15 p-4">
                <p class="font-mono text-[9px] uppercase tracking-[0.12em] text-ink/45">
                  Verificar la descarga
                </p>
                <p class="mt-2 text-[13px] leading-6 text-ink-soft">
                  Si quieres confirmar que el archivo bajó completo y sin cambios, compara su
                  SHA-256 con el de arriba. En Android sirve cualquier app de sumas de
                  verificación; en computadora, <code class="font-mono text-[12px]">sha256sum</code>.
                </p>
              </div>
            )
          }

          <p class="mt-6 text-[13px] leading-6 text-ink/55">
            Si algo falla, escríbenos con el modelo de tu teléfono y la versión de Android. No
            mandes capturas con datos personales.
          </p>
        </div>
      </div>
    </section>

    <section class="bg-label">
      <div
        class="mx-auto flex max-w-[1440px] flex-col items-start justify-between gap-6 border-t border-ink/10 px-4 py-14 sm:px-6 lg:flex-row lg:items-center lg:px-8"
      >
        <p
          class="max-w-[38ch] font-heading text-[clamp(1.8rem,3vw,2.8rem)] font-semibold leading-[1.02] tracking-[-0.04em] text-ink"
        >
          Los reportes ciudadanos ya están abiertos.
        </p>
        <a
          href="/mapa"
          class={cn(
            buttonVariants({ size: "lg" }),
            "h-12 rounded-none bg-ink px-5 text-label hover:bg-maize hover:text-ink",
          )}
        >
          Abrir el mapa
          <span aria-hidden="true" class="ml-1">
            ↗
          </span>
        </a>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
