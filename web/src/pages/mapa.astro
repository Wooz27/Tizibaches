---
import PotholeExplorer from "@/components/map/PotholeExplorer";
import SiteHeader from "@/components/site/SiteHeader.astro";
import BaseLayout from "@/layouts/main.astro";
import { getPotholes } from "@/lib/api";
import { pluralize } from "@/lib/format";

const { features, error } = await getPotholes();
---

<BaseLayout
  title="Mapa abierto · Tízibaches"
  description="Explora todos los baches de Tizimín en un mapa interactivo: estado, severidad, fotos y dirección."
>
  <SiteHeader />
  <main id="contenido" class="mx-auto max-w-[1600px] px-4 pb-8 pt-28 sm:px-6 lg:px-8 lg:pb-10">
    <div class="flex flex-col gap-5 border-b border-border pb-6 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <h1
          class="max-w-[16ch] font-heading text-[clamp(2.3rem,4.6vw,4.4rem)] font-semibold leading-[0.94] tracking-[-0.05em] text-ink"
        >
          El mapa de los baches.
        </h1>
      </div>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-[9px] uppercase tracking-[0.14em] text-muted-foreground">
        <span>{pluralize(features.length, "expediente", "expedientes")}</span>
        <span class="hidden h-3 w-px bg-border sm:block"></span>
        <a href="/" class="underline decoration-border underline-offset-4 transition-colors hover:text-ink">
          Volver a la portada
        </a>
      </div>
    </div>

    <div class="mt-6">
      <PotholeExplorer client:load features={features} error={error} full={true} />
    </div>
  </main>
</BaseLayout>
