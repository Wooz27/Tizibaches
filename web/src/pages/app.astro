---
import AndroidPhone from "@/components/site/AndroidPhone.astro";
import SiteFooter from "@/components/site/SiteFooter.astro";
import SiteHeader from "@/components/site/SiteHeader.astro";
import { buttonVariants } from "@/components/ui/button";
import BaseLayout from "@/layouts/main.astro";
import { cn } from "@/lib/utils";

const capabilities = [
  {
    title: "Entra con Google",
    body: "Sin formularios largos ni contraseñas nuevas. Tu cuenta identifica tus reportes y te permite seguir su estado.",
  },
  {
    title: "Foto y ubicación en un paso",
    body: "La app toma la foto, confirma el GPS y detecta si ya existe un bache cerca para sumar el reporte al mismo expediente.",
  },
  {
    title: "Sigue lo que pasa después",
    body: "Consulta cuándo se verificó, cuándo se programó la obra y cuándo quedó reparado.",
  },
];
---

<BaseLayout
  title="La app para Android · Tízibaches"
  description="La app para reportar baches en Tizimín: Android, acceso con Google, foto, ubicación y seguimiento."
>
  <SiteHeader />
  <main id="contenido" class="pt-24">
    <section class="bg-label text-ink">
      <div
        class="mx-auto grid max-w-[1440px] gap-12 px-4 py-16 sm:px-6 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:gap-20 lg:px-8 lg:py-24"
      >
        <div>
          <h1
            class="max-w-[13ch] font-heading text-[clamp(3rem,6.8vw,6.8rem)] font-semibold leading-[0.9] tracking-[-0.055em]"
          >
            La app para Android.
          </h1>
          <p class="mt-6 max-w-[52ch] text-[16px] leading-7 text-ink-soft">
            Estamos construyendo la app ciudadana en Flutter, solo para Android. Va a permitir
            entrar con Google, tomar una foto en la calle y enviar la ubicación exacta del bache.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a
              href="/mapa"
              class={cn(
                buttonVariants({ size: "lg" }),
                "h-12 rounded-none bg-maize px-5 text-ink hover:bg-ink hover:text-label",
              )}
            >
              Ver el mapa abierto
              <span aria-hidden="true" class="ml-1">↗</span>
            </a>
            <a
              href="/"
              class="text-[14px] font-medium text-ink underline decoration-ink/30 underline-offset-4 transition-colors hover:decoration-ink"
            >
              Volver a la portada
            </a>
          </div>

          <div class="mt-8 flex w-fit items-center gap-3 bg-paper-deep px-4 py-3">
            <svg viewBox="0 0 24 24" class="size-5" fill="none" aria-hidden="true">
              <path d="M5 4.5v15l10-7.5L5 4.5Z" fill="currentColor" />
              <path d="m15 12 4-3v6l-4-3Z" fill="currentColor" opacity="0.55" />
            </svg>
            <div>
              <p class="text-[13px] font-medium leading-4">Google Play</p>
              <p class="text-[12px] leading-4 text-ink-soft">Próximamente, solo Android</p>
            </div>
          </div>
        </div>

        <AndroidPhone class="max-w-[20rem]" />
      </div>
    </section>

    <section class="bg-paper">
      <div class="mx-auto max-w-[1440px] px-4 py-20 sm:px-6 lg:px-8 lg:py-24">
        <div class="grid gap-10 lg:grid-cols-[0.65fr_1.35fr] lg:gap-20">
          <div>
            <h2
              class="max-w-[12ch] font-heading text-[clamp(2.2rem,4.6vw,4.2rem)] font-semibold leading-[0.95] tracking-[-0.05em] text-ink"
            >
              Menos pasos. Más seguimiento.
            </h2>
            <p class="mt-5 max-w-[32ch] text-[15px] leading-6 text-ink-soft">
              La app no reemplaza al mapa: lo alimenta. Cada reporte se convierte en un expediente
              que cualquiera puede consultar.
            </p>
          </div>
          <ol class="divide-y divide-ink/10">
            {
              capabilities.map((item) => (
                <li class="py-6 first:pt-0 last:pb-0">
                  <h3 class="font-heading text-2xl font-semibold leading-tight tracking-[-0.035em] text-ink">
                    {item.title}
                  </h3>
                  <p class="mt-2 max-w-[52ch] text-[15px] leading-6 text-ink-soft">{item.body}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </section>

    <section class="bg-label">
      <div
        class="mx-auto flex max-w-[1440px] flex-col items-start justify-between gap-6 px-4 py-14 sm:px-6 lg:flex-row lg:items-center lg:px-8"
      >
        <p
          class="max-w-[38ch] font-heading text-[clamp(1.8rem,3vw,2.8rem)] font-semibold leading-[1.02] tracking-[-0.04em] text-ink"
        >
          El registro público ya está funcionando.
        </p>
        <a
          href="/mapa"
          class={cn(
            buttonVariants({ size: "lg" }),
            "h-12 rounded-none bg-ink px-5 text-label hover:bg-maize hover:text-ink",
          )}
        >
          Abrir el mapa
          <span aria-hidden="true" class="ml-1">↗</span>
        </a>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
